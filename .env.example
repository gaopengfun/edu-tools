# Tencent Translation Relay Backend Configuration
# Copy this file to .env.local and fill in the values

# Backend API base URL
# Development: http://localhost:8080
# Production: https://your-production-domain.com
VITE_BLOG_API_BASE_URL=http://localhost:8080

# Internal authentication token for translation API
# Obtain this token from your backend administrator or configuration
# This token is sent in the X-Internal-Token header for authentication
VITE_TRANSLATE_INTERNAL_TOKEN=your-internal-token-here
