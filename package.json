{
  "name": "edu-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p \"build-only {@}\" --",
    "build:check": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "oxlint . --fix",
    "format": "oxfmt src/",
    "new:tool": "node scripts/create-tool.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.0",
    "uuid": "^13.0.2",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^24.12.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.42.0",
    "oxlint": "~1.57.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^3.2.9"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
